# /etc/orange/orange.env — root:root 0600, read by the systemd unit.
# Template: copy, fill in, never commit the filled copy.

# QQ official bot (q.qq.com): AppID / AppSecret.
ORANGE_QQ_APP_ID=
ORANGE_QQ_APP_SECRET=
# ORANGE_QQ_SANDBOX=1
# Markdown messages / custom keyboards: only once the platform has granted them
# (the authorization button of dsh-im-qq-panel needs both).
ORANGE_QQ_MARKDOWN=0
ORANGE_QQ_KEYBOARD=0
# The bot's QQ number and UID (u_...), for the group owner authorization link (dsh-im-qq-panel).
ORANGE_QQ_BOT_UIN=
ORANGE_QQ_BOT_UID=

# Admitted chats, comma separated platform chat ids: group:<group_openid>,user:<user_openid>.
# Empty admits every chat the bot is in and every direct chat — fill it in before going live.
ORANGE_QQ_CHATS=
# The bot's admins (the owner): platform user ids, comma separated. On QQ the same person
# has one id in groups (member_openid) and another in the direct chat (user_openid): list both.
ORANGE_ADMINS=
ORANGE_OWNER_NAME=
ORANGE_OWNER_GITHUB=
# The owner's direct chat (user:<user_openid>), bound to the voice session.
ORANGE_OWNER_DM=

# Model routes (provider ids must exist in the harness).
ORANGE_PROVIDER=deepseek-official
ORANGE_ROUTER_MODEL=deepseek-flash
ORANGE_WORKER_MODEL=deepseek-flash
ORANGE_FAST_MODEL=deepseek-flash
ORANGE_QUALITY_MODEL=deepseek-pro
ORANGE_VISION_MODEL=
ORANGE_VOICE_MODEL=

# Working directory of routers and workers; repositories are checked out below it.
ORANGE_WORKSPACE=/home/orange/workspace

# One-time import of the v1 data (scripts/migrate-from-v1.mjs --out <dir>).
# ORANGE_IMPORT_V1=/home/orange/orange-v1-export

# XiaoAI speaker (dsh-plugin-orange-voice).
ORANGE_VOICE_ENABLED=0
ORANGE_VOICE_PORT=4399
# The speaker's address (exact IP, or a prefix ending in "."). The protocol has no auth.
ORANGE_VOICE_ALLOW_FROM=
# The ws:// URL written in the speaker's /data/open-xiaoai/server.txt (for speaker_recover).
ORANGE_VOICE_ADVERTISE=
ORANGE_VOICE_ID=stella
# DeepSeek tool APIs (ASR/TTS). On the VM point the base URL at the host relay, which adds the key;
# leave DEEPSEEK_API_KEY empty there.
DEEPSEEK_TOOLS_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
