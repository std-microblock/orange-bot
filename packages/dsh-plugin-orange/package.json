{
  "name": "dsh-plugin-orange",
  "version": "0.2.0",
  "private": true,
  "description": "橘波特 (Orange) on dsh-im: persona and per-chat profiles for the dispatch routers and workers, long-term memory and user tags, owner projects, GitHub follow-ups into task workers, task model tiers, a tool guard and a private-project leak guard, usage accounting, and dsh-im-panel tabs.",
  "license": "MIT",
  "author": "MicroBlock (https://github.com/std-microblock)",
  "homepage": "https://github.com/std-microblock/orange-bot/tree/dsh-im/packages/dsh-plugin-orange#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/std-microblock/orange-bot.git",
    "directory": "packages/dsh-plugin-orange"
  },
  "keywords": ["dsh", "dsh-plugin", "dsh-im", "qq", "chatbot"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "client", "README.md"],
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-client.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ../../scripts/test-resolve.mjs --test --test-timeout=60000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-im": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-im": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-storage-domain": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}
