{
  "name": "orange-bot",
  "version": "0.1.0",
  "private": true,
  "description": "橘波特 (Orange): a QQ group chat bot stack for DeepSeek Harness — the dsh plugin, the koishi bridge for the official bot, and the crossgram extension for the userbot.",
  "license": "MIT",
  "author": "MicroBlock (https://github.com/std-microblock)",
  "homepage": "https://github.com/std-microblock/orange-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/std-microblock/orange-bot.git"
  },
  "bugs": {
    "url": "https://github.com/std-microblock/orange-bot/issues"
  },
  "keywords": [
    "qq",
    "qqbot",
    "chatbot",
    "dsh",
    "dsh-plugin",
    "satori",
    "koishi",
    "crossgram"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter dsh-plugin-orange run build",
    "typecheck": "pnpm --filter dsh-plugin-orange run typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
    }
  }
}
