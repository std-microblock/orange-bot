# 复制成 .env 再填；.env 不要提交进 git（compose 会读它）
# 这些是容器里的通用名字，entrypoint 会映射成插件要的那几个（名字从 cordis.patch.yml 读）

# 模型：任意 OpenAI 兼容端点
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_KEY=sk-填入你的

# koishi 侧 Satori 的令牌：自己编一串，两个容器共用同一个值
SATORI_TOKEN=换成随机长串

# q.qq.com 建完机器人后拿到的三样（群授权、审核还是得在 q.qq.com 上做）
APP_ID=
APP_SECRET=
BOT_TOKEN=

# 端口（宿主机侧）
KOISHI_PORT=5140
BOT_PORT=3080
